<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RadioGroup
        android:id="@+id/nav_group"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <RadioButton android:id="@+id/nav_api1" android:text="@string/tab_api1"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <RadioButton android:id="@+id/nav_api2" android:text="@string/tab_api2"
            android:checked="true"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <RadioButton android:id="@+id/nav_camerax" android:text="@string/tab_camerax"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <RadioButton android:id="@+id/nav_probe" android:text="@string/tab_probe"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </RadioGroup>

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
